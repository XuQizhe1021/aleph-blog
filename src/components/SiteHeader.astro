---
import { siteConfig } from '../site.config';
import { withBase } from '../utils/paths';
---

<header class="site-header" data-site-header>
	<a class="brand" href={withBase('/')} aria-label="返回首页">
		<span class="brand-dot" aria-hidden="true"></span>
		<span class="brand-text">{siteConfig.title}</span>
	</a>
	<button class="menu" type="button" data-sidebar-launcher aria-label="打开导航" aria-expanded="false">
		<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
			<path d="M4 7h16M4 12h16M4 17h16" />
		</svg>
	</button>
	<script is:inline>
		(() => {
			const root = document.documentElement;
			const setHeaderHeight = () => {
				const header = document.querySelector('[data-site-header]');
				if (header instanceof HTMLElement) {
					root.style.setProperty('--site-header-height', `${header.offsetHeight}px`);
				}
			};
			// 顶栏滚动状态：仅增强阴影，保持高度恒定，避免 dock 与 TOC 因高度变化跟着跳动。
			const onScroll = () => {
				const scrolled = window.scrollY > 10;
				root.dataset.scrolled = scrolled ? '1' : '0';
			};

			if (!window.__SITE_HEADER_BINDED__) {
				window.__SITE_HEADER_BINDED__ = true;
				window.addEventListener('resize', setHeaderHeight);
				window.addEventListener('scroll', onScroll, { passive: true });
				document.addEventListener('astro:page-load', () => {
					setHeaderHeight();
					onScroll();
				});
			}
			setHeaderHeight();
			onScroll();
		})();
	</script>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: var(--site-header-height, 56px);
		padding: 0 16px;
		border-bottom: 1px solid var(--border);
		background: color-mix(in oklab, var(--bg), transparent 4%);
		backdrop-filter: blur(14px);
		transition:
			height 220ms ease,
			box-shadow 220ms ease,
			background-color 220ms ease;
	}

	html[data-scrolled='1'] .site-header {
		box-shadow: 0 10px 30px color-mix(in oklab, var(--bg), transparent 30%);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}

	.brand-dot {
		width: 12px;
		height: 12px;
		border-radius: 4px;
		background: linear-gradient(135deg, var(--accent), var(--accent2));
		box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent), transparent 85%);
		transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.brand:hover .brand-dot {
		transform: rotate(90deg);
	}

	.brand-text {
		font-weight: 650;
		letter-spacing: 0.2px;
	}

	.menu {
		display: none;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: color-mix(in oklab, var(--panel-strong), transparent 15%);
		color: var(--text);
		cursor: pointer;
		transition:
			border-color 180ms ease,
			background-color 180ms ease,
			transform 120ms ease;
	}

	.menu:hover {
		border-color: color-mix(in oklab, var(--accent), var(--border) 40%);
	}

	.menu:active {
		transform: scale(0.94);
	}

	@media (max-width: 980px) {
		.menu {
			display: inline-flex;
		}
	}
</style>
