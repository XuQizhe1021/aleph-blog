---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublicPosts, getAllCategories } from '../utils/blog';
import { withBase } from '../utils/paths';

const posts = await getPublicPosts();
const allCategories = getAllCategories(posts);
const categories = allCategories
	.slice()
	.sort((a, b) => b.count - a.count || a.category.localeCompare(b.category, 'en', { sensitivity: 'base' }))
	.slice(0, 6);
const latest = posts.slice(0, 6);

const totalPosts = posts.length;
const totalCategories = allCategories.length;
const latestUpdateTs = posts.reduce((max, post) => {
	const t = (post.data.updatedDate ?? post.data.pubDate).getTime();
	return Math.max(max, t);
}, 0);
const latestUpdateText = latestUpdateTs
	? new Date(latestUpdateTs).toLocaleDateString('zh-CN')
	: '—';
---

<Layout title="首页" wide>
	<section class="hero panel reveal">
		<div class="hero-head">
			<div class="hero-title">站点概览</div>
			<div class="hero-actions">
				<a class="btn" href={withBase('/posts')}>浏览文章</a>
				<a class="btn" href={withBase('/search')}>搜索</a>
			</div>
		</div>
		<div class="stats">
			<div class="stat">
				<div class="stat-k muted">文章</div>
				<div class="stat-v" data-count-up={totalPosts}>{totalPosts}</div>
			</div>
			<div class="stat">
				<div class="stat-k muted">分类</div>
				<div class="stat-v" data-count-up={totalCategories}>{totalCategories}</div>
			</div>
			<div class="stat">
				<div class="stat-k muted">最近更新</div>
				<div class="stat-v">{latestUpdateText}</div>
			</div>
			<div class="stat">
				<div class="stat-k muted">访问次数</div>
				<div class="stat-v" data-site-views>—</div>
			</div>
		</div>
	</section>

	<div class="home-grid">
		<section class="section reveal">
			<div class="section-head">
				<h2>最新文章</h2>
				<a class="muted" href={withBase('/posts')}>查看全部 →</a>
			</div>
			<div class="grid">
				{latest.length ? latest.map((post) => <PostCard post={post} />) : <div class="muted">暂无文章</div>}
			</div>
		</section>

		<section class="section reveal">
			<div class="section-head">
				<h2>热门分类</h2>
				<a class="muted" href={withBase('/categories')}>查看全部 →</a>
			</div>
			<div class="cats">
				{categories.length ? (
					categories.map((c, i) => (
						<a class="cat panel spot" href={withBase(`/categories/${encodeURIComponent(c.category)}`)}>
							<span class="cat-rank">{String(i + 1).padStart(2, '0')}</span>
							<span class="cat-name">{c.category}</span>
							<span class="cat-count muted">{c.count} 篇</span>
						</a>
					))
				) : (
					<div class="muted">暂无分类</div>
				)}
			</div>
		</section>
	</div>
</Layout>

<style>
	.hero {
		padding: 26px 22px;
		display: grid;
		gap: 18px;
		position: relative;
		overflow: hidden;
	}

	/* 首页头部加入一层极淡的渐变光晕，作为视觉锚点。 */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(circle at 8% 0%, color-mix(in oklab, var(--accent), transparent 82%), transparent 42%),
			radial-gradient(circle at 96% 20%, color-mix(in oklab, var(--accent2), transparent 86%), transparent 46%);
	}

	.hero > * {
		position: relative;
	}

	.hero-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}

	.hero-title {
		font-size: clamp(20px, 4.2vw, 30px);
		font-weight: 800;
		letter-spacing: 0.2px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: flex-end;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
	}

	.stat {
		padding: 14px 16px;
		border-radius: 14px;
		border: 1px solid var(--border);
		background: color-mix(in oklab, var(--panel-strong), transparent 26%);
		display: grid;
		gap: 4px;
	}

	.stat-k {
		font-size: 12px;
	}

	.stat-v {
		font-size: 20px;
		font-weight: 800;
		letter-spacing: 0.2px;
	}

	.section {
		display: grid;
		align-content: start;
		gap: 2px;
	}

	.home-grid {
		margin-top: 18px;
		display: grid;
		grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
		gap: 18px;
		align-items: start;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		margin: 10px 2px;
	}

	h2 {
		margin: 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.cats {
		display: grid;
		gap: 10px;
	}

	.cat {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px;
		padding: 13px 14px;
		text-decoration: none;
	}

	.cat:hover {
		border-color: color-mix(in oklab, var(--accent), var(--border) 30%);
		text-decoration: none;
	}

	.cat-rank {
		font-size: 12px;
		font-weight: 800;
		color: color-mix(in oklab, var(--accent), var(--muted) 20%);
		font-variant-numeric: tabular-nums;
	}

	.cat-name {
		font-weight: 700;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cat-count {
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 980px) {
		.home-grid {
			grid-template-columns: 1fr;
		}
		.grid {
			grid-template-columns: 1fr;
		}
		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
