---
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/Toc.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { getCollection } from 'astro:content';
import { getCategories, getPrimaryCategory } from '../../utils/blog';
import { withBase } from '../../utils/paths';
import { getSiteSettings } from '../../config/site-settings';
import { shouldEnableGiscus } from '../../utils/giscus';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const categories = getCategories(post);
const primaryCategory = getPrimaryCategory(post);
const settings = await getSiteSettings();
const enableGiscus = shouldEnableGiscus(settings, 'post');
---

<Layout title={post.data.title} description={post.data.description} wide>
	<div class="reading-progress" aria-hidden="true">
		<div class="reading-progress-bar" id="reading-progress-bar"></div>
	</div>
	<article class="article">
		<header class="article-head panel" id="article-head">
			<h1 class="article-title">{post.data.title}</h1>
			<div class="article-meta muted">
				<time datetime={post.data.pubDate.toISOString()}>
					发布于 {post.data.pubDate.toLocaleDateString('zh-CN')}
				</time>
				{post.data.updatedDate ? (
					<span>
						<span class="dot" aria-hidden="true">·</span>
						<time datetime={post.data.updatedDate.toISOString()}>
							更新于 {post.data.updatedDate.toLocaleDateString('zh-CN')}
						</time>
					</span>
				) : null}
				<span>
					<span class="dot" aria-hidden="true">·</span>
					<a class="meta-link" href={withBase(`/categories/${encodeURIComponent(primaryCategory)}`)}>{primaryCategory}</a>
				</span>
			</div>
			{categories.length ? (
				<div class="article-tags">
					{categories.map((c) => (
						<a class="badge" href={withBase(`/categories/${encodeURIComponent(c)}`)}>{c}</a>
					))}
				</div>
			) : null}
		</header>

		<div class="toc-mobile">
			<Toc headings={headings} variant="floating" />
		</div>

		<div class="article-body">
			<div class="main-col">
				<div class="content panel">
					<div class="prose">
						<Content />
					</div>
				</div>
				{enableGiscus ? <GiscusComments settings={settings} /> : null}
			</div>
			<div class="side">
				<Toc headings={headings} variant="sidebar" />
			</div>
		</div>
	</article>
	<div class="scroll-jump">
		<button class="scroll-btn" type="button" data-scroll-top aria-label="回到顶部">↑</button>
		<button class="scroll-btn" type="button" data-scroll-bottom aria-label="回到底部">↓</button>
	</div>
	<script is:inline>
		(() => {
			const updateProgress = () => {
				const progressBar = document.getElementById('reading-progress-bar');
				if (!(progressBar instanceof HTMLElement)) return;
				const doc = document.documentElement;
				const scrollable = Math.max(1, doc.scrollHeight - window.innerHeight);
				const progress = Math.min(1, Math.max(0, window.scrollY / scrollable));
				progressBar.style.transform = `scaleX(${progress})`;
			};

			// 标题卡片吸顶压缩：滚动越过其自然位置后切换为一行紧凑态。
			const headEl = () => document.getElementById('article-head');
			// 用 offsetTop 累加得到静态（吸顶前）的文档位置，避免吸顶后 getBoundingClientRect 失真。
			const docTop = (el) => {
				let top = 0;
				let node = el;
				while (node instanceof HTMLElement) {
					top += node.offsetTop;
					node = node.offsetParent;
				}
				return top;
			};
			let headThreshold = 0;
			const measureHead = () => {
				const el = headEl();
				if (!(el instanceof HTMLElement)) return;
				const stickyTop = parseFloat(getComputedStyle(el).top) || 56;
				headThreshold = docTop(el) - stickyTop;
			};
			const updateHead = () => {
				const el = headEl();
				if (!(el instanceof HTMLElement)) return;
				el.classList.toggle('is-stuck', window.scrollY > headThreshold);
			};

			if (!window.__SITE_POST_ACTIONS_BINDED__) {
				window.__SITE_POST_ACTIONS_BINDED__ = true;
				document.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;
					if (target.closest('[data-scroll-top]')) {
						window.scrollTo({ top: 0, behavior: 'smooth' });
						return;
					}
					if (target.closest('[data-scroll-bottom]')) {
						window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
					}
				});
				window.addEventListener(
					'scroll',
					() => {
						updateProgress();
						updateHead();
					},
					{ passive: true }
				);
				window.addEventListener('resize', () => {
					updateProgress();
					measureHead();
				});
				document.addEventListener('astro:page-load', () => {
					updateProgress();
					measureHead();
					updateHead();
				});
			}

			measureHead();
			updateHead();
			updateProgress();
		})();
	</script>
</Layout>

<style>
	.reading-progress {
		position: fixed;
		inset: 0 0 auto;
		height: 3px;
		z-index: 140;
		pointer-events: none;
		background: color-mix(in oklab, var(--panel-strong), transparent 80%);
	}

	.reading-progress-bar {
		height: 100%;
		width: 100%;
		transform: scaleX(0);
		transform-origin: left center;
		background: linear-gradient(
			90deg,
			color-mix(in oklab, var(--accent), white 8%),
			color-mix(in oklab, var(--accent2), var(--accent) 32%)
		);
		box-shadow: 0 0 12px color-mix(in oklab, var(--accent), transparent 62%);
		transition: transform 90ms linear;
	}

	.article {
		max-width: 1360px;
		margin: 0 auto;
		display: grid;
		gap: 14px;
	}

	/* 标题卡片：常态为完整标题区，吸顶后压缩为一行紧凑条。 */
	.article-head {
		padding: 24px 26px;
		position: sticky;
		top: var(--site-header-height, 56px);
		z-index: 85;
		display: grid;
		gap: 12px;
		transition:
			padding 240ms ease,
			gap 240ms ease,
			box-shadow 240ms ease;
	}

	.article-title {
		margin: 0;
		font-size: clamp(24px, 4vw, 34px);
		letter-spacing: 0.2px;
		line-height: 1.25;
		transition:
			font-size 240ms ease,
			line-height 240ms ease;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		font-size: 13px;
		transition: font-size 240ms ease;
	}

	.dot {
		margin: 0 8px;
		opacity: 0.6;
	}

	.meta-link {
		color: inherit;
		text-decoration: none;
	}

	.meta-link:hover {
		text-decoration: underline;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		transition: opacity 180ms ease;
	}

	/* 吸顶压缩态：变矮，标题、时间、分类等收拢为一行铺满宽度。 */
	.article-head.is-stuck {
		padding: 10px 18px;
		display: flex;
		align-items: center;
		gap: 16px;
		box-shadow: 0 12px 30px color-mix(in oklab, var(--bg), transparent 30%);
	}

	.article-head.is-stuck .article-title {
		flex: 1;
		min-width: 0;
		font-size: 16px;
		line-height: 1.4;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.article-head.is-stuck .article-meta {
		flex: none;
		font-size: 12px;
		white-space: nowrap;
	}

	.article-head.is-stuck .article-tags {
		display: none;
	}

	.article-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		gap: 28px;
		align-items: start;
	}

	.content {
		padding: 22px 24px;
		min-width: 0;
		overflow: hidden;
	}

	.main-col {
		display: grid;
		gap: 14px;
		align-content: start;
		min-width: 0;
		max-width: 760px;
	}

	.prose {
		min-width: 0;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.toc-mobile {
		display: none;
	}

	.side {
		display: grid;
		gap: 14px;
		align-self: stretch;
	}

	@media (max-width: 980px) {
		.toc-mobile {
			display: block;
		}
		.article-body {
			grid-template-columns: 1fr;
		}
		.main-col {
			max-width: none;
		}
		.side {
			display: none;
		}
		.article-head.is-stuck .article-meta {
			display: none;
		}
	}

	.scroll-jump {
		position: fixed;
		right: 12px;
		bottom: 130px;
		z-index: 96;
		display: grid;
		gap: 8px;
	}

	.scroll-btn {
		width: 38px;
		height: 38px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: color-mix(in oklab, var(--panel-strong), transparent 20%);
		color: var(--text);
		cursor: pointer;
		font-size: 18px;
		line-height: 1;
	}

	.scroll-btn:hover {
		border-color: color-mix(in oklab, var(--accent), var(--border) 35%);
	}

</style>
