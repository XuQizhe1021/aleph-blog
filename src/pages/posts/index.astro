---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublicPosts, getAllCategories, getPostActivityDate } from '../../utils/blog';
import { withBase } from '../../utils/paths';

const posts = await getPublicPosts();
const categories = getAllCategories(posts);
const postSortMeta = posts.map((post) => ({
	slug: post.slug,
	title: post.data.title,
	pubTime: post.data.pubDate.getTime(),
	activityTime: getPostActivityDate(post).getTime(),
}));
---

<Layout title="文章" wide>
	<div class="posts-layout">
		<aside class="filters panel">
			<div class="filter-title">筛选</div>
			<div class="filter-group">
				<div class="label muted">排序</div>
				<div class="sort-list" role="group" aria-label="排序方式">
					<button class="sort-btn is-active" type="button" data-sort-toggle="latest">最新</button>
					<button class="sort-btn" type="button" data-sort-toggle="updated">最近更新</button>
					<button class="sort-btn" type="button" data-sort-toggle="title">标题</button>
				</div>
			</div>
			<div class="filter-group">
				<div class="label muted">分类</div>
				<div class="chips">
					<a class="chip" href={withBase('/posts')}>全部</a>
					{categories.map((c) => (
						<a class="chip" href={withBase(`/categories/${encodeURIComponent(c.category)}`)}>
							{c.category} <span class="muted">({c.count})</span>
						</a>
					))}
				</div>
			</div>
		</aside>

		<div class="posts-main">
			<section class="head panel">
				<div class="head-left">
					<div class="title">文章</div>
					<div class="muted">共 {posts.length} 篇</div>
				</div>
				<div class="pager" id="pager" hidden>
					<button class="btn" id="prev" type="button">上一页</button>
					<div class="muted" id="page-info"></div>
					<button class="btn" id="next" type="button">下一页</button>
				</div>
			</section>

			<section class="list" id="paged-list">
				{posts.length ? (
					posts.map((post, index) => (
						<div
							class="post-item"
							data-title={postSortMeta[index]?.title.toLocaleLowerCase('zh-CN')}
							data-pub={String(postSortMeta[index]?.pubTime ?? 0)}
							data-updated={String(postSortMeta[index]?.activityTime ?? 0)}
						>
							<PostCard post={post} />
						</div>
					))
				) : (
					<div class="muted">暂无文章</div>
				)}
			</section>
		</div>
	</div>

	<script is:inline>
		(() => {
			const list = document.getElementById('paged-list');
			const pager = document.getElementById('pager');
			const prev = document.getElementById('prev');
			const next = document.getElementById('next');
			const info = document.getElementById('page-info');
			const sortButtons = Array.from(
				document.querySelectorAll('[data-sort-toggle]')
			).filter((el) => el instanceof HTMLButtonElement);
			if (!list || !pager || !prev || !next || !info) return;

			const items = Array.from(list.children).filter((el) => el instanceof HTMLElement);
			if (items.length <= 1) return;

			let pageSize = 10;
			let page = 0;
			let pageCount = 1;
			let sortMode = 'latest';

			const computePageSize = () => (matchMedia('(max-width: 720px)').matches ? 6 : 10);
			const parseNumber = (value) => Number(value || 0);
			const syncSortButtons = () => {
				sortButtons.forEach((btn) => {
					const active = btn.dataset.sortToggle === sortMode;
					btn.classList.toggle('is-active', active);
					btn.setAttribute('aria-pressed', active ? 'true' : 'false');
				});
			};
			const applySort = () => {
				const sorted = items.slice().sort((a, b) => {
					if (sortMode === 'title') {
						return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'zh-CN');
					}
					if (sortMode === 'updated') {
						return parseNumber(b.dataset.updated) - parseNumber(a.dataset.updated);
					}
					return parseNumber(b.dataset.pub) - parseNumber(a.dataset.pub);
				});
				sorted.forEach((el) => list.appendChild(el));
				syncSortButtons();
			};

			const apply = () => {
				applySort();
				pageSize = computePageSize();
				pageCount = Math.max(1, Math.ceil(items.length / pageSize));
				page = Math.min(page, pageCount - 1);
				const start = page * pageSize;
				const end = start + pageSize;
				items.forEach((el, i) => (el.style.display = i >= start && i < end ? '' : 'none'));
				info.textContent = `${page + 1} / ${pageCount}`;
				prev.disabled = page <= 0;
				next.disabled = page >= pageCount - 1;
				pager.hidden = pageCount <= 1;
			};

			sortButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const nextMode = btn.dataset.sortToggle || 'latest';
					if (nextMode === sortMode) return;
					sortMode = nextMode;
					page = 0;
					const url = new URL(window.location.href);
					url.searchParams.set('sort', sortMode);
					history.replaceState(null, '', url);
					apply();
				});
			});
			prev.addEventListener('click', () => {
				page = Math.max(0, page - 1);
				apply();
			});
			next.addEventListener('click', () => {
				page = Math.min(pageCount - 1, page + 1);
				apply();
			});

			let t = 0;
			window.addEventListener('resize', () => {
				window.clearTimeout(t);
				t = window.setTimeout(() => apply(), 120);
			});

			const initialSort = new URL(window.location.href).searchParams.get('sort');
			if (initialSort === 'updated' || initialSort === 'title' || initialSort === 'latest') {
				sortMode = initialSort;
			}
			apply();
		})();
	</script>
</Layout>

<style>
	.posts-layout {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		gap: 16px;
		align-items: start;
	}

	.filters {
		padding: 16px;
		display: grid;
		gap: 16px;
		position: sticky;
		top: 72px;
	}

	.filter-title {
		font-weight: 750;
	}

	.filter-group {
		display: grid;
		gap: 10px;
	}

	.label {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.4px;
	}

	.sort-list {
		display: grid;
		gap: 6px;
	}

	.sort-btn {
		display: flex;
		align-items: center;
		height: 34px;
		padding: 0 12px;
		border-radius: 10px;
		border: 1px solid transparent;
		background: color-mix(in oklab, var(--panel-strong), transparent 30%);
		color: var(--muted);
		cursor: pointer;
		font-size: 13px;
		text-align: left;
		transition:
			color 180ms ease,
			background-color 180ms ease,
			border-color 180ms ease;
	}

	.sort-btn:hover {
		color: var(--text);
	}

	.sort-btn.is-active {
		color: var(--text);
		border-color: color-mix(in oklab, var(--accent), var(--border) 30%);
		background: linear-gradient(
			90deg,
			color-mix(in oklab, var(--accent), transparent 82%),
			color-mix(in oklab, var(--accent2), transparent 92%)
		);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		height: 30px;
		padding: 0 10px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: color-mix(in oklab, var(--panel-strong), transparent 18%);
		color: var(--text);
		text-decoration: none;
		font-size: 13px;
	}

	.chip:hover {
		text-decoration: none;
		border-color: color-mix(in oklab, var(--accent), var(--border) 30%);
	}

	.posts-main {
		display: grid;
		gap: 14px;
		min-width: 0;
	}

	.head {
		padding: 18px;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 12px;
		align-items: center;
		position: sticky;
		top: 72px;
		z-index: 80;
	}

	.title {
		font-size: 24px;
		font-weight: 800;
	}

	.head-left {
		display: grid;
		gap: 6px;
	}

	.list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.post-item {
		min-width: 0;
	}

	.pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	@media (max-width: 980px) {
		.posts-layout {
			grid-template-columns: 1fr;
		}
		.filters {
			position: static;
		}
		.list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.head {
			grid-template-columns: 1fr;
			align-items: start;
		}
		.pager {
			width: 100%;
		}
	}
</style>
